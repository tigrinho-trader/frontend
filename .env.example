# Copie para .env (ou .env.local) e preencha com os dados da sua aplicação no Auth0.
# Estes arquivos ficam fora do git; só este exemplo é versionado.

# Domínio do tenant (Applications > sua SPA > Settings > Domain)
VITE_AUTH0_DOMAIN=
# Client ID da aplicação "Single Page Application"
VITE_AUTH0_CLIENT_ID=
# Identifier da API cadastrada em Applications > APIs (o mesmo AUTH0_AUDIENCE do api-gateway)
VITE_AUTH0_AUDIENCE=
